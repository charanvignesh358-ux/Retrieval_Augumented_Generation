# Free key: https://console.groq.com/keys
# Copy this file to ".env" and fill in the values.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Logins: user:password:role, comma separated. Roles: admin (upload/delete/logs) or user (ask only).
# Avoid ":" and "," inside passwords. The app refuses to start while "change_me" is left in.
APP_USERS=admin:change_me_admin:admin,staff:change_me_staff:user

# Any long random text. Keeps people logged in after restarts.
SECRET_KEY=change_me_long_random_text
TOKEN_HOURS=8

# OCR for scanned PDFs and images (true/false)
OCR_ENABLED=true

TOP_K=5
CHUNK_WORDS=350
CHUNK_OVERLAP=60
